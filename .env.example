APP_ENV=dev
ADDR=:8080

# DB options:
# 1) Auto mode (recommended): picks postgres for postgres:// URL, sqlite otherwise
DB_DRIVER=auto

# SQLite example:
# DATABASE_URL=file:credit_mvp.db?_foreign_keys=on

# PostgreSQL example:
# DATABASE_URL=postgres://credit_user:credit_pass@localhost:5432/credit_mvp?sslmode=disable

# Required
JWT_SECRET=change-me-to-strong-random-value
SEED_MANAGER_PASSWORD=change-me-manager-password
SEED_MANAGER_EMAIL=manager@bank.local
SEED_MANAGER_FULL_NAME=Default Manager

ACCESS_TOKEN_TTL=15m
REFRESH_TOKEN_TTL=24h
READ_HEADER_TIMEOUT=5s
READ_TIMEOUT=10s
WRITE_TIMEOUT=15s
IDLE_TIMEOUT=30s
MAX_REQUEST_BODY_BYTES=1048576
MAX_LOGIN_ATTEMPTS=5
LOGIN_BLOCK_DURATION=15m
